# Copy to .env and fill in. Never commit the filled-in file.
# Every secret here is server-side only — the mobile app ships none of them.

NODE_ENV=development
PORT=8080

# Public URL of this server. Must be https in production; it is the OAuth issuer.
PUBLIC_BASE_URL=http://localhost:8080

# Supabase project (choose an EU region — design doc §10.1).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Bypasses RLS. Server only, never in a client bundle, never in a log.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ANTHROPIC_API_KEY=sk-ant-...
# Must be a model eligible for zero data retention (§10.3): the Fable tier
# requires 30-day retention, so it is not a valid choice here.
VISION_MODEL=claude-opus-5

# Signs the access tokens the MCP connector accepts. 32+ random characters:
#   openssl rand -base64 48
MCP_TOKEN_SECRET=change-me-to-at-least-32-random-characters

# Open Food Facts asks for identifiable traffic with a contact address.
OFF_USER_AGENT=awe/0.1 (you@example.com)

# Photo estimates are the only thing that costs money — roughly 3 cents each
# on claude-opus-5, billed to the Anthropic API key above (pay-as-you-go, NOT
# covered by a Claude.ai subscription). Barcode, recipe and manual logging
# never call the API at all.
#
# The daily cap is what bounds the bill; the hourly one catches a retry loop.
# 30 photos a day is generous for one person and worst-cases at ~$0.90/day.
RATE_LIMIT_VISION_PER_HOUR=12
RATE_LIMIT_VISION_PER_DAY=30
RATE_LIMIT_API_PER_MINUTE=120

# --- Mobile app (apps/mobile/.env) ---
# These are PUBLIC by design and shipped in the app bundle. The anon key is
# safe to expose because RLS is what actually protects the data (§10.2).
# EXPO_PUBLIC_API_URL=http://localhost:8080
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
